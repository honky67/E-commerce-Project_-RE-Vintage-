DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/vinyl_db
# generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
APP_ENV=development            # "production" disables demo accounts and the demo social-login flow

# Browsers normally reach the API through the Next.js proxy, so CORS rarely matters. For direct access:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   # comma-separated; dev also allows any private-network IP
# APP_URL=http://192.168.56.10:3000      # public site URL, only needed if auto-detection is wrong
# UPLOAD_DIR=/var/lib/revintage/uploads  # default: backend/uploads

# Social login. Leave blank to use the demo flow in development.
# Redirect URI to register with each provider: <APP_URL>/api/auth/oauth/<google|facebook|instagram>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
